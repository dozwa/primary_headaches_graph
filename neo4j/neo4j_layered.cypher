// --- Eindeutigkeits-Constraints (legen zugleich den Index fuer die MATCHes unten an)
CREATE CONSTRAINT diagnosis_id IF NOT EXISTS FOR (n:Diagnosis) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT criterion_id IF NOT EXISTS FOR (n:Criterion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT subcriterion_id IF NOT EXISTS FOR (n:SubCriterion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT symptom_id IF NOT EXISTS FOR (n:Symptom) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT attribute_id IF NOT EXISTS FOR (n:Attribute) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT disorder_id IF NOT EXISTS FOR (n:Disorder) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT logic_id IF NOT EXISTS FOR (n:Logic) REQUIRE n.id IS UNIQUE;

