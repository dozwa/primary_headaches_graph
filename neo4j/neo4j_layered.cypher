MERGE (n:Ontology:Symptom {id:'migraine_with_aura_attack'}) SET n.name='migraine with aura attack', n.surface_en=['MA attack', 'MWA attack', 'migraine aura attack', 'migraine with aura episode', 'migrainous attack with aura'];
MERGE (n:Ontology:Symptom {id:'neurological_examination'}) SET n.name='neurological examination';
MERGE (n:Ontology:Symptom {id:'oral_cold_stimulus'}) SET n.name='oral cold stimulus', n.surface_en=['cold food/drink stimulus', 'cold oral stimulus', 'cold stimulus to mouth', 'ice cream stimulus', 'palatal cold stimulus'];
MERGE (n:Ontology:Symptom {id:'pain_becoming_continuous_and_unremitting'}) SET n.name='pain becoming continuous and unremitting';
MERGE (n:Ontology:Symptom {id:'patient'}) SET n.name='patient', n.surface_en=['individual', 'subject'];
MERGE (n:Ontology:Symptom {id:'physical_exercise'}) SET n.name='physical exercise', n.surface_en=['exercise', 'physical activity'];
MERGE (n:Ontology:Symptom {id:'relief_of_external_compression_or_traction'}) SET n.name='relief of external compression or traction';
MERGE (n:Ontology:Symptom {id:'remission_period'}) SET n.name='remission period';
MERGE (n:Ontology:Symptom {id:'removal_of_cold_stimulus'}) SET n.name='removal of cold stimulus';
MERGE (n:Ontology:Symptom {id:'sexual_activity'}) SET n.name='sexual activity', n.surface_en=['coitus', 'sexual intercourse'];
MERGE (n:Ontology:Symptom {id:'stab'}) SET n.name='stab', n.surface_en=['jab', 'prick'];
MERGE (n:Ontology:Symptom {id:'time_to_peak_intensity'}) SET n.name='time to peak intensity';
MERGE (n:Ontology:Symptom {id:'valsalva_manoeuvre'}) SET n.name='valsalva manoeuvre', n.surface_en=['Valsalva', 'valsalva maneuver'];
MERGE (n:Ontology:Symptom {id:'vertigo_attack'}) SET n.name='vertigo attack', n.surface_en=['vertiginous episode'];
MERGE (n:Ontology:Symptom {id:'vomiting_episode'}) SET n.name='vomiting episode', n.surface_en=['bout of vomiting', 'emesis episode', 'throwing up episode', 'vomiting spell'];

// --- Ontologie-Axiome (IS_A, MUTUALLY_EXCLUSIVE)
MATCH (a:Ontology:Attribute {id:'mild_pain_intensity'}), (b:Ontology:Attribute {id:'mild_to_moderate_intensity'}) MERGE (a)-[r:IS_A]->(b);
MATCH (a:Ontology:Attribute {id:'moderate_pain_intensity'}), (b:Ontology:Attribute {id:'mild_to_moderate_intensity'}) MERGE (a)-[r:IS_A]->(b);
MATCH (a:Ontology:Attribute {id:'bilateral_location'}), (b:Ontology:Attribute {id:'unilateral_location'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);
MATCH (a:Ontology:Attribute {id:'mild_pain_intensity'}), (b:Ontology:Attribute {id:'moderate_pain_intensity'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);
MATCH (a:Ontology:Attribute {id:'mild_pain_intensity'}), (b:Ontology:Attribute {id:'severe_pain_intensity'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);
MATCH (a:Ontology:Attribute {id:'mild_pain_intensity'}), (b:Ontology:Attribute {id:'very_severe_pain_intensity'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);
MATCH (a:Ontology:Attribute {id:'moderate_pain_intensity'}), (b:Ontology:Attribute {id:'severe_pain_intensity'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);
MATCH (a:Ontology:Attribute {id:'moderate_pain_intensity'}), (b:Ontology:Attribute {id:'very_severe_pain_intensity'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);
MATCH (a:Ontology:Attribute {id:'severe_pain_intensity'}), (b:Ontology:Attribute {id:'very_severe_pain_intensity'}) MERGE (a)-[r:MUTUALLY_EXCLUSIVE]->(b);

