// ===== 4.5.1
MERGE (d:Ontology:Diagnosis {id:'4.5.1'}) SET d.name='Headache attributed to external application of a cold stimulus';
MERGE (n:Ontology:Criterion {id:'4.5.1/A'}) SET n.name='A', n.label='A', n.text_en=['At least two acute headache episodes fulfilling criteria B and C'];
MERGE (n:Ontology:Criterion {id:'4.5.1/B'}) SET n.name='B', n.label='B', n.text_en=['Brought on by and occurring only during application of an external cold stimulus to the head'];
