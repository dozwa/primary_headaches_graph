// ===== 1.2
MERGE (d:Ontology:Diagnosis {id:'1.2'}) SET d.name='Migraine with aura';
MERGE (n:Ontology:Criterion {id:'1.2/A'}) SET n.name='A', n.label='A', n.text_en=['At least two attacks fulfilling criteria B and C'];
MERGE (n:Ontology:Criterion {id:'1.2/B'}) SET n.name='B', n.label='B', n.text_en=['One or more of the following fully reversible aura symptoms:'];
MERGE (n:Ontology:Criterion {id:'1.2/C'}) SET n.name='C', n.label='C', n.text_en=['At least three of the following six characteristics:'];
MERGE (n:Ontology:SubCriterion {id:'1.2/A#n2'}) SET n.name='A#n2', n.label='A', n.text_en=['At least two attacks fulfilling criteria B and C'];
