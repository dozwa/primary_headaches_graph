MERGE (n:Ontology:SubCriterion {id:'1.2/C/4'}) SET n.name='C/4', n.label='C/4', n.text_en=['at least one aura symptom is unilateral[^2]'];
MERGE (n:Ontology:SubCriterion {id:'1.2/C/5'}) SET n.name='C/5', n.label='C/5', n.text_en=['at least one aura symptom is positive[^3]'];
MERGE (n:Ontology:SubCriterion {id:'1.2/C/6'}) SET n.name='C/6', n.label='C/6', n.text_en=['the aura is accompanied, or followed within 60 minutes, by headache'];
